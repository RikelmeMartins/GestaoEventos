# ==========================================
#  Gestão de Eventos Acadêmicos - .gitignore
# ==========================================

# ---------- Backend (Python / Flask) ----------
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
instance/

# ---------- Frontend (Node / React / Vite) ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Segredos (senhas, chaves) ----------
.env
.env.*
!.env.example

# ---------- Arquivos gerados (v2: certificados) ----------
uploads/
certificados_gerados/

# ---------- Editor / Sistema ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini